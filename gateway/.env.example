# ---- upstream ----------------------------------------------------------
SEARXNG_BASE_URL=http://127.0.0.1:8888

# ---- auth --------------------------------------------------------------
# LOCAL TESTING: leave DATABASE_URL unset and set DEV_API_KEY. One hard-coded
# key, no quotas, no usage log. Never expose this to a network.
DEV_API_KEY=sk_live_dev_change_me

# PRODUCTION: set DATABASE_URL (Supabase -> Settings -> Database -> Connection
# string -> URI) and DEV_API_KEY is ignored.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# ADMIN_TOKEN=<openssl rand -hex 32>

# ---- tuning ------------------------------------------------------------
# Each upstream page is a REAL scrape of Google/DDG/Brave. Raising this makes
# you more likely to get captcha'd.
MAX_UPSTREAM_PAGES=3
UPSTREAM_CONCURRENCY=3
CACHE_TTL_FRESH=600
CACHE_TTL_MAX=21600

# ---- VPS ---------------------------------------------------------------
# Redis is REQUIRED if you run more than one uvicorn worker: with the memory
# backends, each worker keeps its own cache and its own rate-limit buckets, so
# you get N caches and N times the configured limit.
# CACHE_BACKEND=redis
# RATE_LIMIT_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/0
# PUBLIC_BASE_URL=https://search.example.com

# ---- compat ------------------------------------------------------------
# lower_bound = honest (totalResults is what we actually hold).
# inflated    = fabricate a Google-looking number for clients that demand one.
TOTAL_RESULTS_MODE=lower_bound
STRICT_PARAMS=false
LOG_RAW_QUERIES=false
